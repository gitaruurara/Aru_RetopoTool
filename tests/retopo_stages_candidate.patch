+// One joined team per solver call; barriers keep Jacobi stages separate.
+// No threads survive this call or wait while Maya is idle.
+template<class F,class End> static void parallelStages(int n,int stages,F fn,End end){
+    const int threads=n>=512?projectionThreads(n):1;
+    if(threads==1){
+        for(int stage=0;stage<stages;++stage){for(int i=0;i<n;++i)fn(stage,i);end(stage);}
+        return;
+    }
+    std::mutex mutex;std::condition_variable cv;
+    int remaining=threads,generation=0;
+    bool started=false,abort=false;
+    std::atomic<int> cursor{0};std::atomic<bool> failed{false};
+    std::exception_ptr error;
+    auto work=[&]{
+        {std::unique_lock<std::mutex> lock(mutex);
+         cv.wait(lock,[&]{return started;});if(abort)return;}
+        for(int stage=0;stage<stages;++stage){
+            for(;;){
+                int start=cursor.fetch_add(128,std::memory_order_relaxed);
+                if(start>=n)break;
+                if(failed.load(std::memory_order_relaxed))continue;
+                try{for(int i=start;i<std::min(n,start+128);++i)fn(stage,i);}
+                catch(...){std::lock_guard<std::mutex> lock(mutex);
+                    if(!error)error=std::current_exception();failed.store(true,std::memory_order_relaxed);}
+            }
+            std::unique_lock<std::mutex> lock(mutex);int phase=generation;
+            if(--remaining==0){
+                if(!failed.load(std::memory_order_relaxed)){
+                    try{end(stage);}catch(...){if(!error)error=std::current_exception();failed.store(true,std::memory_order_relaxed);}
+                }
+                cursor.store(0,std::memory_order_relaxed);remaining=threads;++generation;
+                lock.unlock();cv.notify_all();
+            }else cv.wait(lock,[&]{return generation!=phase;});
+        }
+    };
+    std::vector<std::future<void>> tasks;tasks.reserve(threads-1);
+    try{for(int worker=1;worker<threads;++worker)tasks.push_back(std::async(std::launch::async,work));}
+    catch(...){
+        {std::lock_guard<std::mutex> lock(mutex);abort=true;started=true;}
+        cv.notify_all();for(auto& task:tasks)task.get();throw;
+    }
+    {std::lock_guard<std::mutex> lock(mutex);started=true;}cv.notify_all();
+    work();for(auto& task:tasks)task.get();if(error)std::rethrow_exception(error);
 }
