<fragment  uiName="getPointSizeAsFloat" name="getPointSizeAsFloat" type="geometryShader" class="ShadeFragment" version="1.0" feature_level="40" >
    <description>
<![CDATA[
get point-size parameter as the varying input]]>
</description>
    <keyword value="geometryShader" />
    <properties>
        <struct  name="inputs" size="1" struct_name="geometryInS" />
        <float  name="pointSize" semantic="radius" flags="isRequirementOnly,varyingInputParam" />
    </properties>
    <values>
    </values>
    <outputs>
        <float  name="pointSize" />
    </outputs>
    <implementation  >
    <implementation  render="OGSRenderer" language="HLSL" lang_version="11.000000" >
        <function_name val="getPointSizeAsFloat" />
        <source>
            <![CDATA[
float getPointSizeAsFloat( geometryInS inputs[1] ) 
{ 
	 return inputs[0].pointSize; 
} 
            ]]>
        </source>
    </implementation>
